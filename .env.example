# Configuration template. Copy to .env only when it does not exist, then fill required values.
# Local services and development Compose read this root file. Production uses root .env.production with the same settings.
# Do not put signing phrases, bot tokens or tunnel tokens in VITE_* variables.

# Bot token used by the API to verify Telegram Mini App initData. Keep this server-side.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram ID of the user account holding real gifts. Must match the worker session; development Compose requires it even when starting only PostgreSQL.
CUSTODY_TELEGRAM_USER_ID=

# Maximum age of a receipt confirmation or complete custody snapshot before trading is blocked. Default: 7200 seconds.
CUSTODY_MAX_AGE_SECONDS=7200

# Sale commission in basis points, integer 0-10000. Default: 50 (0.5%); gift withdrawal fees are separate.
MARKETPLACE_FEE_BPS=50

# Optional external HTTPS manifest URL. Otherwise the browser fetches /tonconnect-manifest.json from VITE_TONCONNECT_APP_URL or its current origin; the generated file declares the configured app origin or https://dev.tplace.store.
VITE_TONCONNECT_MANIFEST_URL=

# Optional Telegram Mini App return link used after wallet interaction, e.g. https://t.me/your_bot/your_app.
VITE_TONCONNECT_TWA_RETURN_URL=

# Native TON network: -239 for mainnet or -3 for testnet. Treasury, RPC and connected wallets must use the same network.
TON_NETWORK=-239

# TON Center JSON-RPC v2 endpoint for the selected network. It must support archival getTransactions.
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC

# Optional RPC API key. Without a key the API throttles requests to one every 1.1 seconds per process.
TON_RPC_API_KEY=

# Public native TON treasury address. Deposits are disabled while this is empty; payouts require matching signing credentials.
TON_TREASURY_ADDRESS=

# Server-only signing phrase; prefer TON_TREASURY_MNEMONIC_FILE. An explicit file takes precedence; never expose either secret to VITE_*.
TON_TREASURY_MNEMONIC=

# Signing secret file, absolute or relative to backend/node. For development Docker use /app/runtime/ton-payout-mnemonic.secret; production uses /run/secrets/treasury.txt.
TON_TREASURY_MNEMONIC_FILE=

# Set true only after verifying the funded, activated treasury and matching signing phrase. Samples default to false; deposits do not depend on this flag.
TON_PAYOUTS_ENABLED=false

# Fixed fee included in the entered cash withdrawal total. Default: 50000000 (0.05 GRAM); recipient receives total minus this fee.
TON_WITHDRAW_FEE_NANO=50000000

# Payouts signed together in one treasury transfer, 1-4. Default: 4.
TON_PAYOUT_BATCH_SIZE=4

# Public HTTPS app origin used inside the generated manifest. Default manifest origin: https://dev.tplace.store; localhost and plain HTTP are rejected. Production Compose requires an explicit public origin in .env.production.
VITE_TONCONNECT_APP_URL=https://dev.tplace.store

# Required API signing secret, at least 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Enable the development login endpoint only outside production. Default: false; never enable it in production. Also set VITE_ALLOW_DEV_AUTH=true for the browser.
ALLOW_DEV_AUTH=false

# Comma-separated exact TCP peer IPs allowed to supply the last X-Forwarded-For address. Empty means no trusted proxy; production Compose fixes this to Nginx.
TRUSTED_PROXY_ADDRESSES=

# Token for an existing Cloudflare Tunnel. Required only with the tunnel profile; configure its hostname to reach http://frontend:5173.
TUNNEL_TOKEN=

# Require a fresh custody_reconcile status in ops:check / the production operations-monitor. This flag does not disable the worker listener or reconciliation.
CUSTODY_RECONCILE_ALERTS=true

# Maximum custody_reconcile age allowed by ops:check / operations-monitor when CUSTODY_RECONCILE_ALERTS=true. Default: 7200 seconds.
CUSTODY_RECONCILE_ALERT_AFTER_SECONDS=7200

# Maximum requests per client address per API process in a 60-second window. Default: 300.
HTTP_RATE_LIMIT=300

# Maximum modifying requests per client address per API process per 60 seconds. Default: 120.
HTTP_WRITE_RATE_LIMIT=120

# Maximum authentication requests per client address per API process per 60 seconds. Default: 30.
HTTP_AUTH_RATE_LIMIT=30

# Additional maximum requests per authenticated user per API process per 60 seconds. Default: 300.
HTTP_USER_RATE_LIMIT=300

# Additional maximum modifying requests per authenticated user per API process per 60 seconds. Default: 120.
HTTP_USER_WRITE_RATE_LIMIT=120

# Node API

# Local Node PostgreSQL URL. Development Compose supplies its internal database URL; production requires host postgres. URL-encode password characters.
DATABASE_URL=postgresql://tplace:tplace@127.0.0.1:5432/tplace

# Required only in production; use the same password in DATABASE_URL and PYTHON_DATABASE_URL, URL-encoded there.
POSTGRES_PASSWORD=

# Local Node HTTP port. Default: 4000; development Compose fixes the container port to 4000.
PORT=4000

# Minimum listing/offer price in GRAM. Default: 0.5.
MARKETPLACE_MIN_PRICE=0.5

# Maximum listing/offer price in GRAM. Default: 100000.
MARKETPLACE_MAX_PRICE=100000

# Log query durations above this threshold without SQL or values. Default: 0 (disabled).
DB_SLOW_QUERY_MS=0

# Telegram worker

# Local worker SQLAlchemy URL. Its launcher maps this to DATABASE_URL; development Compose supplies its internal URL. Production requires host postgres.
PYTHON_DATABASE_URL=postgresql+psycopg://tplace:tplace@127.0.0.1:5432/tplace

# Telegram user API ID for Kurigram. Required together with TELEGRAM_API_HASH.
TELEGRAM_API_ID=

# Telegram user API hash for Kurigram. Keep private.
TELEGRAM_API_HASH=

# Persistent Kurigram session basename. Default: account; reuse the same session across restarts.
TELEGRAM_SESSION_NAME=account

# Seconds between complete custody reconciliations. Default: 3600.
CUSTODY_RECONCILE_INTERVAL_SECONDS=3600

# Maximum Stars paid by the custodian for each gift transfer. Default: 25; 0 allows only free transfers.
GIFT_WITHDRAW_MAX_STARS=25

# Total custody scan timeout in seconds. Default: 60; clamped to 1-300. An incomplete scan never marks gifts absent.
GIFT_CUSTODY_SCAN_TIMEOUT_SECONDS=60

# Frontend (public VITE_* values only)

# Browser API base URL. Default: /api, forwarded by Vite in development and Nginx in production.
VITE_API_BASE_URL=/api

# Vite development proxy target for /api. Default: http://localhost:4000; development Compose overrides it with http://backend-node:4000.
VITE_API_PROXY_TARGET=http://localhost:4000

# Allow the development login only on localhost/loopback. Default: false; the API must also enable ALLOW_DEV_AUTH.
VITE_ALLOW_DEV_AUTH=false

# Local development identity Telegram ID, used only when development authentication is enabled on localhost. Default: 100001.
VITE_DEV_TELEGRAM_ID=100001

# Local development identity username. Used only with development authentication on localhost.
VITE_DEV_USERNAME=dev_user

# Local development identity display name. Used only with development authentication on localhost.
VITE_DEV_FIRST_NAME=Dev

# Maximum PostgreSQL connections per API process, at least 3. Default: 15. The TON payment and offer expiry workers each hold one for their lock.
DB_POOL_MAX=15

# Server-side limits for every API connection, in milliseconds; 0 disables one. Defaults: 10000, 5000, 30000.
# Migrations, catalog sync and worker lock transactions lift them for their own transaction.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Comma-separated browser origins allowed to call the API directly (CORS), e.g. https://admin.example.com. The app itself uses same-origin /api and needs none. Empty: any origin outside production, none in production.
CORS_ALLOWED_ORIGINS=

# Maximum age of Telegram initData accepted at login, 60-86400 seconds. Default: 600. A shorter window limits replay of intercepted initData.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=600

# Lifetime of API tokens in seconds, 60-86400. Default: 21600 (6 hours). The Mini App signs in again with fresh initData on each launch.
AUTH_TOKEN_TTL_SECONDS=21600
