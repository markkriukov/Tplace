{
  "name": "tplace-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "ajv": "^8.20.0",
    "axios": "1.20.0",
    "bip39": "^3.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "sequelize": "^6.37.3"
  },
  "scripts": {
    "dev": "node --import ./scripts/load-environment.js --watch src/index.js",
    "start": "node --import ./scripts/load-environment.js src/index.js",
    "db:migrate": "node --import ./scripts/load-environment.js scripts/migrate.js",
    "db:catalog:sync": "node --import ./scripts/load-environment.js scripts/sync-catalog.js",
    "db:catalog:refresh": "node --import ./scripts/load-environment.js scripts/sync-catalog.js --refresh",
    "db:profile": "node --import ./scripts/load-environment.js scripts/profile-database.js",
    "fees:report": "node --import ./scripts/load-environment.js scripts/marketplace-revenue.js",
    "wallet:payouts:setup": "node --import ./scripts/load-environment.js scripts/setup-ton-payout.js",
    "wallet:payouts:check": "node --import ./scripts/load-environment.js scripts/setup-ton-payout.js --check",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "ops:check": "node --import ./scripts/load-environment.js scripts/check-operations.js",
    "payments:review": "node --import ./scripts/load-environment.js scripts/payment-review.js",
    "payments:unmatched": "node --import ./scripts/load-environment.js scripts/unmatched-deposits.js",
    "users:revoke-tokens": "node --import ./scripts/load-environment.js scripts/revoke-tokens.js",
    "users:admin": "node --import ./scripts/load-environment.js scripts/set-admin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ton/sandbox": "^0.45.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
